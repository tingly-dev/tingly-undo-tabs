{
  "manifest_version": 3,
  "name": "Tab History Manager",
  "version": "1.0.0",
  "description": "Record and reopen closed tabs in order",
  "permissions": [
    "tabs",
    "storage",
    "sessions"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/index.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
